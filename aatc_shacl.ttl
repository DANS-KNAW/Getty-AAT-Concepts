@prefix dct: <http://purl.org/dc/terms/> .
@prefix ex: <http://example.com/ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ConceptShape
	a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
			PREFIX skos: <http://www.w3.org/2004/02/skos/core#> 
			PREFIX owl: <http://www.w3.org/2002/07/owl#>
            SELECT ?concept WHERE {
                ?concept a skos:Concept .
                FILTER NOT EXISTS { ?concept owl:deprecated true }
            }
        """ ;
    ] ;
	sh:property [                 
		sh:path skos:prefLabel ;     
        sh:minCount 1 ;  # note: there are terms with only EN labels
		sh:datatype rdf:langString ;
		sh:severity sh:Warning ;  # acronyms have not langStrings
	] ;
	sh:property [                 
		sh:path skos:inScheme ;
		sh:class skos:ConceptScheme ;
		sh:nodeKind sh:IRI ;
	] ;
	sh:property [                 
		sh:path rdf:type ;
		sh:nodeKind sh:IRI ;
		sh:hasValue skos:Concept
	] ;
	sh:property [                 
		sh:path dct:issued ;
		sh:nodeKind sh:Literal ;
		sh:datatype xsd:dateTime ;
	] ;
	sh:closed true .

ex:DeprecatedConceptShape
	a sh:NodeShape ;
    sh:target [
        a sh:w ;
        sh:select """
			PREFIX skos: <http://www.w3.org/2004/02/skos/core#> 
			PREFIX owl: <http://www.w3.org/2002/07/owl#>
            SELECT ?concept WHERE {
                ?concept a skos:Concept ;
				         owl:deprecated true .
            }
        """ ;
    ] ;
	sh:property [                 
		sh:path owl:deprecated ;     
        sh:minCount 1 ; 
		sh:datatype xsd:boolean ;
	] ;
	sh:property [                 
		sh:path skos:prefLabel ;     
        sh:minCount 1 ;  
	] ;
	sh:property [                 
		sh:path skos:inScheme ;
		sh:class skos:ConceptScheme ;
		sh:nodeKind sh:IRI ;
	] ;
	sh:property [                 
		sh:path rdf:type ;
		sh:nodeKind sh:IRI ;
		sh:hasValue skos:Concept
	] ;
	sh:property [                 
		sh:path dct:isReplacedBy ;
		sh:nodeKind sh:IRI ;
        sh:minCount 1 ;  
	] ;
	sh:closed true .

ex:ConceptSchemeShape
	a sh:NodeShape ;
	sh:targetClass skos:ConceptScheme ;
    sh:property [
        sh:path dct:title ;
		sh:datatype rdf:langString ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
		sh:datatype rdf:langString ;
    ] ;
    sh:property [
        sh:path rdfs:comment ;
		sh:datatype rdf:langString ;
    ] ;	
    sh:property [
        sh:path dct:creator ;
		sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path dct:license ;
		sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path dct:created ;
		sh:nodeKind sh:Literal ;
		sh:datatype xsd:date ;
    ] ;
	sh:property [                 
		sh:path rdf:type ;
		sh:nodeKind sh:IRI ;
		sh:hasValue skos:ConceptScheme ;
	] ;	
	sh:property [                 
		sh:path owl:versionInfo ;
		sh:nodeKind sh:Literal ;
	] ;		
	sh:closed true . 
	
